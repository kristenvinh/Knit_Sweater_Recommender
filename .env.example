# Ravelry API credentials (required)
RAVELRY_ACCESS_KEY=your_ravelry_access_key
RAVELRY_PERSONAL_KEY=your_ravelry_personal_key

# CORS configuration (optional)
# Comma-separated origins. Defaults support localhost dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# Regex also supports localhost/127 on any port and file:// origin (null) by default.
CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$|^null$

# API key enforcement (optional; disabled by default)
# When true, clients must send header: X-API-Key matching one of the Ravelry keys.
REQUIRE_API_KEY=false

# Request rate limiting (optional)
# Local development defaults:
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=120

# Production recommended values:
# REQUIRE_API_KEY=true
# RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_MAX_REQUESTS=30
